sourceDir = {{ env "DOTFILES_SOURCE_DIR" | default "~/.local/share/chezmoi" | quote }}

{{ $probablyDc := or (env "REMOTE_CONTAINERS_IPC" | not | not) (eq (env "USER") "vscode") (stat "/workspaces" | not | not) -}}
{{ $isCodespaces := env "CODESPACES" | not | not -}}
{{ $isDc := or $probablyDc $isCodespaces -}}
{{/* Keyed on the distro ID rather than a path, so it is false by
     construction on WSL (ID=arch/ubuntu), dev containers, macOS and Windows. */}}
{{ $isOmarchy := eq (dig "osRelease" "id" "" .chezmoi) "omarchy" -}}
{{ $binDir := ".local/bin" -}}

{{/* Work identity is driven by ~/work.email: a file whose sole contents
     are one work email address. When the file is absent, the
     DOTFILES_WORK_EMAIL env var is consulted as a fallback (Codespaces
     user secrets surface as env vars). The email's domain selects the
     identity; no email or an unrecognized domain means personal. Add new
     jobs to $identities. */}}
{{ $identities := dict
    "kirbtech.com"    "kirbtech"
    "journalytic.com" "journalytic" -}}
{{ $identity := "personal" -}}
{{ $workEmail := "" -}}
{{/* Defaults to ~/work.email; DOTFILES_WORK_EMAIL_FILE relocates it (render.sh). */}}
{{ $workEmailPath := joinPath .chezmoi.homeDir "work.email" -}}
{{ if env "DOTFILES_WORK_EMAIL_FILE" -}}{{ $workEmailPath = env "DOTFILES_WORK_EMAIL_FILE" -}}{{ end -}}
{{ $email := "" -}}
{{ if stat $workEmailPath -}}
  {{ $email = include $workEmailPath | trim -}}
{{ else if env "DOTFILES_WORK_EMAIL" -}}
  {{ $email = env "DOTFILES_WORK_EMAIL" | trim -}}
{{ end -}}
{{ if $email -}}
  {{ $domain := $email | splitList "@" | last -}}
  {{ if hasKey $identities $domain -}}
    {{ $identity = index $identities $domain -}}
    {{ $workEmail = $email -}}
  {{ end -}}
{{ end -}}
{{ $isWork := ne $identity "personal" -}}

{{/* The Bitwarden desktop app is the only SSH agent, reached directly or
     forwarded into an SSH session (ssh -A), which is how a headless box
     reaches it. Dev containers use the host's forwarded agent instead, and
     on WSL the app runs on the Windows side where its Unix socket is
     unreachable. Sandboxed
     installs (App Store, snap, flatpak) put the socket inside their
     container, so candidates are checked in order at runtime; the last
     entry, the native install path, is the fallback. */}}
{{ $isWsl := env "WSL_DISTRO_NAME" | not | not -}}
{{ $bitwardenSshSocks := list -}}
{{ if eq .chezmoi.os "darwin" -}}
  {{ $bitwardenSshSocks = append $bitwardenSshSocks (joinPath .chezmoi.homeDir "Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock") -}}
{{ else if eq .chezmoi.os "linux" -}}
  {{ $bitwardenSshSocks = append $bitwardenSshSocks (joinPath .chezmoi.homeDir "snap/bitwarden/current/.bitwarden-ssh-agent.sock") -}}
  {{ $bitwardenSshSocks = append $bitwardenSshSocks (joinPath .chezmoi.homeDir ".var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock") -}}
{{ end -}}
{{ $bitwardenSshSocks = append $bitwardenSshSocks (joinPath .chezmoi.homeDir ".bitwarden-ssh-agent.sock") -}}
{{ $bitwardenSshAgent := and (not $isDc) (not $isWsl) (ne .chezmoi.os "windows") -}}

{{/* Commits are signed with the "GitHub Signing" key stored in Bitwarden,
     always through an SSH agent: Bitwarden's own, the host's forwarded into
     a dev container, or the Windows-side one on WSL (reached through
     ssh-keygen.exe). Codespaces sign server-side with GitHub's own
     web-flow key. */}}
{{ $gitSign := not $isCodespaces -}}

[data]
    # Environment Info
    os = {{ .chezmoi.os | quote }}
    arch = {{ .chezmoi.arch | quote }}
    hostname = {{ .chezmoi.hostname | quote }}

    isMac = {{ eq .chezmoi.os "darwin" }}
    isWindows = {{ eq .chezmoi.os "windows" }}
    isWsl = {{ $isWsl }}
    isDc = {{ $isDc }}
    isOmarchy = {{ $isOmarchy }}

    # Identity
    identity = {{ $identity | quote }}
    isPersonal = {{ not $isWork }}
    isWork = {{ $isWork }}

    # Emails
    personalEmail = "carson@carsonseese.com"
    workEmail = {{ $workEmail | quote }}

    # Signing
    gitSigningPubKey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGUhU31PFPWI9ggTCNK7JuYnc7O7RrUKgjjt2aWDCVIP"
    gitSign = {{ $gitSign }}

    # SSH agent
    bitwardenSshAgent = {{ $bitwardenSshAgent }}
    bitwardenSshSocks = {{ $bitwardenSshSocks | toJson }}

    # Directory paths
    binDir = {{ $binDir | quote }}
    binDirAbs = {{ joinPath .chezmoi.homeDir $binDir | quote }}

[add]
    # This repo is public: refuse to add files containing detected secrets.
    # Override deliberately with `chezmoi add --secrets=ignore` on false positives.
    secrets = "error"

[github]
    refreshPeriod = "12h"

[edit]
    command = "code"
    args = ["--wait"]
    apply = true

[merge]
    command = "code"
    args = ["--wait", "--merge", "--diff"]
