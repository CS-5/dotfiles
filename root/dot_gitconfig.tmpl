[user]
  name = Carson Seese
  email = {{ .personalEmail }}
{{- if and .gitSign (not .isDc) }}
  signingkey = {{ joinPath .chezmoi.homeDir ".ssh/git_signing" | replace "\\" "/" }}
{{- end }}

{{ if and .isWork (not .isDc) -}}
[includeIf "gitdir:~/dev/work/"]
  path = .gitconfig-work
{{ end -}}
{{ if and .isWork .isDc -}}
[include]
  path = .gitconfig-work
{{ end -}}

[core]
  fsmonitor = true
  pager = hunk pager
  excludesfile = {{ joinPath .chezmoi.homeDir ".gitignore-global" | replace "\\" "/" }}
{{- if .isWsl }}
  sshCommand = ssh.exe
{{- else if .isWindows }}
  sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- end }}

[merge]
  conflictstyle = zdiff3
  ff = false

[rerere]
  enabled = true
  autoupdate = true

[init]
  defaultBranch = main

[push]
  autoSetupRemote = true

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true

[commit]
  verbose = true

[column]
  ui = auto

[branch]
  sort = -committerdate

[tag]
  sort = -version:refname

{{ if .isWindows -}}
[credential]
  helper = manager
{{- end }}

[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential

{{ if .gitSign -}}
{{ if .isDc -}}
# Written by git-signing-agent on apply and at shell startup: a forwarded agent
# key that is registered with GitHub, with signing on, or no file (no signing)
# when the agent has none. git skips the include when the file doesn't exist.
[include]
  path = ~/.local/state/git-signing.gitconfig
{{- else -}}
[commit]
  gpgSign = true

[tag]
  gpgSign = true
{{- end }}

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = {{ joinPath .chezmoi.homeDir ".ssh/allowed_signers" | replace "\\" "/" }}
{{- if .isWindows }}
  program = C:/Windows/System32/OpenSSH/ssh-keygen.exe
{{- end }}
{{- end }}

[alias]
  co = checkout
  br = branch
  ci = commit
  st = status
  pushfwl = push --force-with-lease

[pull]
  rebase = true

# Per-machine overrides, never managed by the dotfiles. Last, so it wins; git
# skips the include when the file doesn't exist.
[include]
  path = ~/.config/local/gitconfig
