{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash

# Regenerate whenever any pinned tool version changes, not just when this
# script changes — otherwise completions go stale as gh/docker upgrade.
# mise config hash: {{ include "private_dot_config/mise/config.toml.tmpl" | sha256sum }}

if command -v gh >/dev/null 2>&1; then
  gh completion -s fish > "{{ .chezmoi.homeDir }}/.config/fish/completions/gh.fish"
fi

if command -v docker >/dev/null 2>&1 && docker >/dev/null 2>&1; then
  docker completion fish > "{{ .chezmoi.homeDir }}/.config/fish/completions/docker.fish"
fi
{{- end }}