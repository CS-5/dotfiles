{{ if not .isWindows -}}
#!/bin/bash

if ! command -v mise >/dev/null 2>&1; then
    echo "mise not found, skipping update"
    exit 0
fi

# Not every mise is ours to replace:
#
#   - Packagers can disable self-update so that mise is updated through the
#     package manager instead. Those builds ship a marker file and exit nonzero
#     with "mise is installed via a package manager, cannot update" — Homebrew,
#     Arch's mise, Omarchy's mise-bin, distro packages generally.
#   - A root-owned mise (an image that installs it system-wide at build time)
#     cannot be replaced by an unprivileged user either.
#
# Neither case is detected up front on purpose: which paths carry the disable
# marker is mise's own business, and a plain network failure shouldn't fail an
# apply either. Keeping mise current is a convenience here, so a failure is
# stepped over. A package-managed mise is the expected case on every apply
# there, so mise's refusal is recognized by its message and stays silent; any
# other failure is shown with mise's own reason. Should mise reword that
# message, the refusal is just shown like any other failure.
if ! out=$(mise self-update --yes --quiet 2>&1 >/dev/null); then
    if ! printf '%s\n' "$out" | grep -q 'installed via a package manager'; then
        printf '%s\n' "$out" >&2
        echo "mise self-update skipped (it failed)"
    fi
fi
{{- end }}
