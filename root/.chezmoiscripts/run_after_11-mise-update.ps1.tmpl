{{ if .isWindows -}}
if (Get-Command mise -ErrorAction SilentlyContinue) {
    # See run_after_11-mise-update.sh.tmpl: a package-managed mise (scoop, winget,
    # chocolatey) has self-update disabled and exits nonzero. That refusal is
    # expected on every apply, so it stays silent; any other failure is shown,
    # and neither fails the apply.
    $out = mise self-update --yes --quiet 2>&1
    if ($LASTEXITCODE -ne 0 -and "$out" -notmatch 'installed via a package manager') {
        $out | ForEach-Object { Write-Host "$_" }
        Write-Host "mise self-update skipped (it failed)"
    }
} else {
    Write-Host "mise not found, skipping update"
}

# Without this the script's exit code follows the last native command, which
# would fail the apply on a self-update that was never going to be possible.
exit 0
{{- end }}
