# Managed by chezmoi as a conf.d drop-in, so ~/.config/mise/config.toml stays
# free for `mise use -g` (yours, or Omarchy's agent wrappers). A tool pinned
# there outranks the pin here.
[tools]
lazydocker = "0.25.2"
ast-grep = "0.51.1"
hyperfine = "2.0.0"
duf = "0.9.1"
lsd = "1.2.0"
gh = "2.103.3"
worktrunk = "0.81.0"
cloudflared = "2026.10.7"
aube = "2.8.5"
hunk = "0.24.1"

"github:Ataraxy-Labs/sem" = "0.29.0"
"github:backnotprop/plannotator" = "0.28.45"
{{ if not .isOmarchy -}}
# Omarchy installs these as system packages.
starship = "1.27.0"
lazygit = "0.66.2"
fd = "10.5.0"
fzf = "0.74.5"
jq = "1.8.2"
ripgrep = "15.2.0"
zoxide = "0.10.0"
usage = "6.12.1"
{{ end -}}
{{ if not .isWindows -}}
{{ if not .isOmarchy -}}
# Omarchy ships herdr as a package and deletes mise copies of it: a stale
# client would shadow /usr/bin/herdr with an older wire protocol.
herdr = "0.9.5"
{{ end -}}
zellij = "0.45.1"
"github:zyedidia/eget" = "1.3.4"
{{- end }}
{{ if not .isDc -}}
go = "1.27.3"
node = "lts"
bun = "1.4.4"
python = "3.15.0"
pnpm = "12.17.0"
{{- end }}

[settings]

idiomatic_version_file_enable_tools = ["node", "go", "python", "bun"]

minimum_release_age = "7d"

# Pin SHA256 + per-platform download URLs in mise.lock alongside this config.
# Survives upstream tampering and avoids GitHub rate limits on reinstall.
lockfile = true

# Re-verify provenance/checksums on every install (auto-enables
# locked_verify_provenance). Falls back to checksum-only when provenance
# metadata is unavailable, so this stays safe with mixed backends.
paranoid = true

# The upstream nodejs signing key's creation date drifts newer than the
# tarball signature timestamp, which trips gpg with "Time conflict" and
# fails `mise install`. Tarballs are still SHA-checksum verified against
# mise's release metadata; we only skip the PGP layer.
node.verify = false

# Install corepack shims after installing node
node.corepack = true

self_update.auto = true
self_update.check_duration = "24h"
self_update.minimum_release_age = "24h"


