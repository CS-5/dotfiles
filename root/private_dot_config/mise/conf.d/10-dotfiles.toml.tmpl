{{/* A conf.d drop-in rather than ~/.config/mise/config.toml. Omarchy provisions
     lazy tool wrappers with `omarchy mise install`, and each of those runs
     `mise use -g <tool>` on every invocation, which rewrites config.toml — so
     chezmoi owning that file meant the two clobbered each other on every apply.
     mise structurally refuses to write into conf.d, so this file is safe from
     that side, and Omarchy keeps config.toml to itself.

     Trade-off: inside a global config dir, conf.d is the *lower* precedence, so
     a tool named in both files resolves to Omarchy's copy. That is why the
     Omarchy branch below drops every tool Omarchy already provides rather than
     pinning a version that would be silently ignored. */ -}}
[tools]
{{ if not .isOmarchy -}}
{{/* Omarchy ships this first group already: starship, lazygit, fd, fzf, jq,
     ripgrep, zoxide, usage and herdr as pacman packages from its own mirror,
     gh and hunk as `omarchy mise install` wrappers. A second copy either
     shadows Omarchy's or is shadowed by it depending on where the shim dir
     lands on PATH — and for herdr specifically Omarchy ships a migration that
     deletes mise copies, because a stale client and /usr/bin's daemon share a
     wire protocol. */ -}}
starship = "1.26.0"
lazygit = "0.64.1"
fd = "10.4.2"
fzf = "0.74.3"
jq = "1.8.2"
ripgrep = "15.2.0"
zoxide = "0.10.0"
usage = "6.4.0"
gh = "2.98.0"
"github:modem-dev/hunk" = "0.19.0"
{{ end -}}
lazydocker = "0.25.2"
ast-grep = "0.45.2"
hyperfine = "1.20.0"
duf = "0.9.1"
lsd = "1.2.0"
worktrunk = "0.74.0"
cloudflared = "2026.8.2"
aube = "2.1.0"

"github:Ataraxy-Labs/sem" = "0.23.1"
"github:backnotprop/plannotator" = "0.27.8"
{{ if ne .chezmoi.os "windows" -}}
{{ if not .isOmarchy -}}
herdr = "0.8.2"
{{ end -}}
zellij = "0.45.0"
"github:zyedidia/eget" = "1.3.4"
{{- end }}
{{ if not .isDc -}}
go = "1.27.0"
node = "lts"
bun = "1.4.0"
python = "3.14.7"
pnpm = "11.24.0"
{{- end }}

[settings]

idiomatic_version_file_enable_tools = ["node", "go", "python", "bun"]

# Tools must be published for at least N days before they will be installed
minimum_release_age = "7d"

# Pin SHA256 + per-platform download URLs in a mise.lock next to each project
# config. Survives upstream tampering and avoids GitHub rate limits on
# reinstall. (Global configs are exempt: mise only writes a lockfile for one on
# an explicit `mise lock --global`.)
lockfile = true

# Re-verify provenance/checksums on every install (auto-enables
# locked_verify_provenance). Falls back to checksum-only when provenance
# metadata is unavailable, so this stays safe with mixed backends.
paranoid = true

# The upstream nodejs signing key's creation date drifts newer than the
# tarball signature timestamp, which trips gpg with "Time conflict" and
# fails `mise install`. Tarballs are still SHA-checksum verified against
# mise's release metadata; we only skip the PGP layer.
node.verify = false

# Install corepack shims after installing node
node.corepack = true

