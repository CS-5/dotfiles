hunk = "0.23.0"

"github:Ataraxy-Labs/sem" = "0.27.0"
"github:backnotprop/plannotator" = "0.28.4"
{{ if ne .chezmoi.os "windows" -}}
herdr = "0.9.3"
zellij = "0.45.1"
