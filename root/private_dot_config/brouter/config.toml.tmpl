# Brouter config: https://github.com/CS-5/Brouter
#
# Managed by chezmoi; edit root/private_dot_config/brouter/config.toml.tmpl in
# the dotfiles repo, not this file. Rules are checked top to bottom and the
# first match wins. Check a link with:
#   /Applications/Brouter.app/Contents/MacOS/Brouter test <url>
{{- $kirbtechMac := and .isMac (eq .identity "kirbtech") }}

{{- /* Native-app rules render only for apps installed when chezmoi applies.
     Brouter sends a rule whose app is missing to `default` rather than on to
     the next rule, which would skip the Edge rules on the work Mac. Re-apply
     (or run `update`) after installing one of these apps. */}}
{{- $installed := dict }}
{{- range $app := list "Linear" "Microsoft Teams" }}
{{-   range $dir := list "/Applications" (joinPath $.chezmoi.homeDir "Applications") }}
{{-     if stat (joinPath $dir (printf "%s.app" $app)) }}
{{-       $_ := set $installed $app true }}
{{-     end }}
{{-   end }}
{{- end }}

{{ if $kirbtechMac -}}
default = "com.google.Chrome"
{{- else -}}
default = "app.zen-browser.zen"
{{- end }}
strip_tracking = true
hide_icon = false
{{- if $installed }}

# --- Native apps -------------------------------------------------------------
{{- end }}
{{- if hasKey $installed "Linear" }}

[[rules]]
host = "linear.app"
open = "Linear"
scheme = "linear"
{{- end }}
{{- if hasKey $installed "Microsoft Teams" }}

# Teams deep links (/l/...) open in the app under its msteams:// scheme.
# Other Teams URLs go to a browser, where Teams offers to open the app.
[[rules]]
host = "teams.microsoft.com"
path = "/l/*"
open = "Microsoft Teams"
scheme = "msteams"
{{- end }}
{{- if $kirbtechMac }}

# --- Work browser ------------------------------------------------------------

[[rules]]
regex = "(?i)kirbtech"
open = "com.microsoft.edgemac"

[[rules]]
host = [
  # Zubie
  "zubie.com",
  # Cloudflare
  "cloudflare.com",
  "cloudflareaccess.com",
  # Claude
  "claude.ai",
  "claude.com",
  "anthropic.com",
  # ChatGPT
  "chatgpt.com",
  "openai.com",
  # Microsoft
  "microsoft.com",
  "microsoftonline.com",
  "microsoft365.com",
  "cloud.microsoft",
  "office.com",
  "office365.com",
  "sharepoint.com",
  "live.com",
  "outlook.com",
  "onedrive.com",
  "azure.com",
  "powerbi.com",
  # Bitwarden
  "bitwarden.com",
  "bitwarden.eu",
]
open = "com.microsoft.edgemac"
{{- else }}

# --- Zen containers ----------------------------------------------------------
# Needs the "Open external links in a container" extension installed in Zen.

[[rules]]
regex = "(?i)scstem"
open = "app.zen-browser.zen"
container = "Robotics"

[[rules]]
regex = "(?i)journalytic"
open = "app.zen-browser.zen"
container = "Work"
{{- end }}
