{{ if .isOmarchy -}}
# Omarchy publishes OMARCHY_PATH and the mise/~/.local/bin PATH entries through
# a POSIX-sh snippet; zsh is not a shell Omarchy sets up, so source it directly
# rather than going through its bash rc chain.
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap

{{ end -}}
{{ template "shell-rcd" . }}
