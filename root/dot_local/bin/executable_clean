#!/bin/bash

# Prune old and unused packages left behind by `update`: orphaned system
# packages and package caches (apt/brew), and mise tool versions no longer
# referenced by any config, plus mise's download cache.
#
# Managed by chezmoi; installed to ~/.local/bin so it works from any shell.

set -eufo pipefail

step() { printf '\n\033[1;34m==>\033[0m \033[1m%s\033[0m\n' "$1"; }

# Omarchy prunes packages its own way, and the differences are not cosmetic --
# see the pacman branch below. Same detection as `update`.
is_omarchy() {
    [[ -r /etc/os-release ]] && grep -q '^ID=omarchy$' /etc/os-release
}

case "$(uname -s)" in
Darwin)
    step "Pruning Homebrew packages and caches"
    brew autoremove
    brew cleanup --prune=all
    ;;
Linux)
    if is_omarchy; then
        # Omarchy differs from plain Arch on both halves of this, and getting
        # either wrong is destructive rather than merely untidy:
        #
        #   - The package cache is Omarchy's ONLY offline downgrade path, so it
        #     keeps two versions per package (omarchy-update-pkg-prune runs
        #     `paccache -rk2`). `pacman -Sc` would empty it and take the ability
        #     to roll back a bad update with it.
        #   - Orphans are reviewed, not assumed: omarchy-update-orphan-pkgs
        #     lists them and asks, defaulting to no. Removing them unattended
        #     here would undo that deliberate choice.
        step "Pruning the package cache (keeping 2 versions per package)"
        sudo paccache -rk2

        step "Reviewing orphaned packages"
        omarchy-update-orphan-pkgs
    elif command -v apt-get >/dev/null 2>&1; then
        step "Pruning apt packages and caches"
        sudo apt-get autoremove --purge -y
        sudo apt-get clean
    elif command -v pacman >/dev/null 2>&1; then
        step "Pruning pacman packages and caches"
        # -Qtdq lists orphans (deps no longer required by anything); it exits
        # nonzero when there are none, which is success here, hence || true.
        orphans="$(pacman -Qtdq || true)"
        if [[ -n "$orphans" ]]; then
            # shellcheck disable=SC2086 # orphan names are word-split on purpose
            sudo pacman -Rns --noconfirm $orphans
        fi
        # Drop cached packages for anything no longer installed.
        sudo pacman -Sc --noconfirm
    fi
    ;;
esac

if command -v mise >/dev/null 2>&1; then
    step "Pruning unused mise tool versions"
    mise prune --yes

    step "Clearing mise download cache"
    mise cache clear
fi

step "Clean complete"
