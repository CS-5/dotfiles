{{ if and .isDc .gitSign -}}
#!/bin/sh

# Turn commit signing on or off in a dev container, depending on whether the
# forwarded SSH agent holds a key that is registered with GitHub as a signing
# key. The host's agent may be Bitwarden or a plain ssh-agent; either way only
# a registered key is used, since signing with any other key would show as
# Unverified on GitHub.
#
# git has no "sign if possible" setting, so the choice is made ahead of time:
# with a match, ~/.local/state/git-signing.gitconfig (included by
# ~/.gitconfig) sets the key and turns signing on; without one, the file is
# removed and commits go unsigned. Registered keys come from
# ~/.ssh/allowed_signers, which chezmoi writes from GitHub's list on apply.
#
# Shells run this at startup with --quiet; run it by hand after (re)connecting
# an agent to pick it up without a new shell.
#
# Managed by chezmoi; installed to ~/.local/bin.

quiet=false
[ "${1:-}" = "--quiet" ] && quiet=true

say() { $quiet || printf 'git-signing-agent: %s\n' "$1"; }

include="$HOME/.local/state/git-signing.gitconfig"
signers="$HOME/.ssh/allowed_signers"

key=""
if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -r "$signers" ] && command -v ssh-add >/dev/null 2>&1; then
    # A locked or unresponsive agent must not hang shell startup.
    if command -v timeout >/dev/null 2>&1; then
        agent_keys=$(timeout 3 ssh-add -L 2>/dev/null)
    else
        agent_keys=$(ssh-add -L 2>/dev/null)
    fi
    # allowed_signers lines are "principal type blob"; agent lines "type blob comment".
    key=$(printf '%s\n' "$agent_keys" | awk '
        NR == FNR { registered[$2 " " $3] = 1; next }
        ($1 " " $2) in registered { print $1 " " $2; exit }
    ' "$signers" -)
fi

if [ -z "$key" ]; then
    rm -f "$include"
    say "no registered signing key in the SSH agent; commits will not be signed"
    exit 0
fi

content=$(printf '[user]\n\tsigningkey = key::%s\n[commit]\n\tgpgSign = true\n[tag]\n\tgpgSign = true' "$key")
if [ ! -f "$include" ] || [ "$(cat "$include")" != "$content" ]; then
    mkdir -p "$(dirname "$include")"
    printf '%s\n' "$content" > "$include"
fi
$quiet || say "signing with $(printf '%s\n' "$key" | ssh-keygen -lf - 2>/dev/null || printf '%s' "$key")"
{{ end -}}
