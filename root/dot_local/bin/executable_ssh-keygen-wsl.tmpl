{{ if .isWsl -}}
#!/bin/sh

# git's gpg.ssh.program on WSL. The Bitwarden SSH agent runs on the Windows
# side, where only Windows OpenSSH can reach it, so signing goes through
# ssh-keygen.exe. It can't open the Linux paths git passes (temp buffers and
# signatures, the key literal, allowed_signers), so each absolute path that
# exists is translated with wslpath first. The other arguments (options,
# namespace, principals) are never absolute paths, so they pass through.
#
# Managed by chezmoi; installed to ~/.local/bin.

for arg do
    shift
    case "$arg" in
        /*) [ -e "$arg" ] && arg=$(wslpath -w "$arg") ;;
    esac
    set -- "$@" "$arg"
done
exec ssh-keygen.exe "$@"
{{ end -}}
